# Redirige todas las rutas que no sean archivos reales hacia index.html,
# para que React Router (/admin, /checkout, /product/:id, etc.) funcione
# incluso al recargar la página o entrar directo por URL.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si el archivo o carpeta solicitado existe de verdad, sírvelo tal cual
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Si no, entrega index.html y deja que React Router decida qué mostrar
  RewriteRule ^ index.html [L]
</IfModule>

# Cache básico para archivos estáticos compilados
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>
